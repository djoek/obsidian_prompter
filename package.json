{
  "name": "obsidian-teleprompter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --outfile=main.js --format=cjs --target=browser --external=obsidian --external=electron",
    "watch": "bun run build --watch",
    "dev": "bun dev/index.html",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
